<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
LaunchAgent that snapshots the brand-shield SQLite DB once per day and
copies it to ~/Documents/Claude/brand-shield-backups/ with a timestamp.
Time Machine then handles offsite/redundant backup of that folder.

Schedule: every day at 03:30 local time.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.byerim.brand-shield-backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>__HOME__/code/brand-shield/scripts/backup-local.sh</string>
    </array>

    <!-- Run daily at 03:30 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/brand-shield-backup.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/brand-shield-backup.log</string>
</dict>
</plist>
